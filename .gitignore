# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment secrets
.env
.env.*
!.env.example

# Generated APKs and build artifacts
*.apk
*.aab

# Local build settings passed with --dart-define-from-file (see
# dart_defines.example.json). Kept out of git in case secrets are added.
dart_defines.json

# Release signing: the upload keystore and its passwords live outside the
# repo; never commit them.
android/key.properties
*.jks
*.keystore
